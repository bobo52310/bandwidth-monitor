# Cloudflare Pages headers — applied to dist/ on deploy.

/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  # No includeSubDomains / preload: both are hard to take back.
  Strict-Transport-Security: max-age=31536000
  Cross-Origin-Opener-Policy: same-origin
  # 'unsafe-inline' covers Astro's inline module script and the hero clock (is:inline).
  # The two Google hosts are for the font stylesheet and files; the two Cloudflare hosts are for the analytics beacon.
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self' https://cloudflareinsights.com; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; object-src 'none'

# Hashed bundles — long cache, immutable.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Static brand / icon assets — moderate cache.
/favicon.svg
  Cache-Control: public, max-age=86400
/og-default.png
  Cache-Control: public, max-age=86400
/icon-*.png
  Cache-Control: public, max-age=604800
/apple-touch-icon.png
  Cache-Control: public, max-age=604800
