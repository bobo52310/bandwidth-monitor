---
import Layout from '../layouts/Layout.astro'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import Hero from '../components/sections/Hero.astro'
import Features from '../components/sections/Features.astro'
import HowItWorks from '../components/sections/HowItWorks.astro'
import ChartDemo from '../components/sections/ChartDemo.astro'
import SpeedTest from '../components/sections/SpeedTest.astro'
import FAQ from '../components/sections/FAQ.astro'
import DownloadCTA from '../components/sections/DownloadCTA.astro'
import { defaultLang, useTranslations } from '../i18n'

const lang = defaultLang
const t = useTranslations(lang)
---

<Layout title={t('meta.title')} description={t('meta.description')} lang={lang}>
  <Header lang={lang} />
  <main>
    <Hero lang={lang} />
    <Features lang={lang} />
    <HowItWorks lang={lang} />
    <ChartDemo />
    <SpeedTest />
    <FAQ lang={lang} />
    <DownloadCTA lang={lang} />
  </main>
  <Footer lang={lang} />
</Layout>
