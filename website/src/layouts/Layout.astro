---
import '../styles/global.css'
import { type Lang, defaultLang, getAlternateLinks } from '../i18n'

interface Props {
  title: string
  description?: string
  lang?: Lang
  /** Keep the page out of search results: robots noindex, no canonical, no hreflang. */
  noindex?: boolean
}

const {
  title,
  description = '常駐選單列的極簡網速監控工具。精準追蹤頻寬峰值與日常用量，用客觀數據幫你決定是否真的需要升級網路。',
  lang = defaultLang,
  noindex = false
} = Astro.props

// hreflang needs absolute URLs; relative ones are ignored by search engines.
const alternateLinks = getAlternateLinks(Astro.url.pathname).map(({ lang: altLang, href }) => ({
  lang: altLang,
  href: new URL(href, Astro.site).href
}))
const defaultHref = new URL('/', Astro.site).href

const canonicalURL = new URL(Astro.url.pathname, Astro.site)
const ogImageURL = new URL('/og-default.png', Astro.site)

const localeMap: Record<Lang, string> = {
  'zh-Hant': 'zh_TW',
  'en': 'en_US',
  'ja': 'ja_JP',
  'ko': 'ko_KR'
}

const otherLocales = (Object.keys(localeMap) as Lang[]).filter((l) => l !== lang)

const htmlLangMap: Record<Lang, string> = {
  'zh-Hant': 'zh-Hant',
  'en': 'en',
  'ja': 'ja',
  'ko': 'ko'
}
---

<!doctype html>
<html lang={htmlLangMap[lang]}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#FFFFFF" />
    {noindex ? (
      <meta name="robots" content="noindex" />
    ) : (
      <link rel="canonical" href={canonicalURL} />
    )}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <title>{title}</title>

    <!-- Fonts: Inter (UI + display), Noto Sans TC (CJK). Mono uses system fonts (SF Mono/Menlo). -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Noto+Sans+TC:wght@400;500;600&display=swap"
      rel="stylesheet"
    />

    <!-- Alternate language links (x-default stays on the zh-Hant root) -->
    {!noindex && alternateLinks.map(({ lang: altLang, href }) => (
      <link rel="alternate" hreflang={htmlLangMap[altLang]} href={href} />
    ))}
    {!noindex && <link rel="alternate" hreflang="x-default" href={defaultHref} />}

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={localeMap[lang]} />
    {otherLocales.map((l) => <meta property="og:locale:alternate" content={localeMap[l]} />)}
    {!noindex && <meta property="og:url" content={canonicalURL} />}
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:alt" content={title} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content="Bandwidth ECG" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />
    <meta name="twitter:image:alt" content={title} />

    <!-- Cloudflare Web Analytics (manual beacon) -->
    <script
      is:inline
      defer
      src="https://static.cloudflareinsights.com/beacon.min.js"
      data-cf-beacon='{"token": "0da3371c2e9b49bdb9f6dfa0f03341b7"}'
    ></script>
  </head>
  <body class="antialiased">
    <slot />
  </body>
</html>
