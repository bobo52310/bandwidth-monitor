---
import { languages, getLangFromUrl, getLocalizedPath, type Lang } from '../i18n';

const currentLang = getLangFromUrl(Astro.url);
const currentPath = Astro.url.pathname.replace(/^\/(en|ja|ko)/, '') || '/';

const shortLabel: Record<Lang, string> = {
  'zh-Hant': 'ZH',
  'en': 'EN',
  'ja': 'JA',
  'ko': 'KO'
};
---

<div class="relative" data-language-switcher>
  <button
    type="button"
    class="mono-label text-[11px] flex items-center gap-1.5 px-2 py-1.5 text-[var(--color-ink-2)] hover:text-[var(--color-ink)] transition-colors"
    aria-label="Switch language"
    data-dropdown-toggle
  >
    <span>{shortLabel[currentLang]}</span>
    <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" />
    </svg>
  </button>

  <div
    class="absolute right-0 mt-1 w-36 bg-[var(--color-paper)] border border-[var(--color-ink)] rounded-[3px] py-1 hidden z-50"
    data-dropdown-menu
  >
    {Object.entries(languages).map(([lang, label]) => (
      <a
        href={getLocalizedPath(lang as Lang, currentPath)}
        class:list={[
          'mono-label block px-3 py-2 text-[11px] transition-colors',
          lang === currentLang
            ? 'bg-[var(--color-ink)] text-[var(--color-paper)]'
            : 'text-[var(--color-ink-2)] hover:bg-[var(--color-paper-dim)] hover:text-[var(--color-ink)]'
        ]}
      >
        {shortLabel[lang as Lang]} · {label}
      </a>
    ))}
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const switchers = document.querySelectorAll('[data-language-switcher]');

    switchers.forEach((switcher) => {
      const toggle = switcher.querySelector('[data-dropdown-toggle]');
      const menu = switcher.querySelector('[data-dropdown-menu]');

      if (toggle && menu) {
        toggle.addEventListener('click', (e) => {
          e.stopPropagation();
          menu.classList.toggle('hidden');
        });

        document.addEventListener('click', () => {
          menu.classList.add('hidden');
        });

        menu.addEventListener('click', (e) => {
          e.stopPropagation();
        });
      }
    });
  });
</script>
