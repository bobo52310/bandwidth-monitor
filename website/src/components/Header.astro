---
// V1 Clinical ECG — minimal top-band, like a chart header
import LanguageSwitcher from './LanguageSwitcher.astro'
import { type Lang, defaultLang, useTranslations, getLocalizedPath } from '../i18n'

interface Props {
  lang?: Lang
}

const { lang = defaultLang } = Astro.props
const t = useTranslations(lang)
const homeHref = getLocalizedPath(lang, '/')
---

<header class="sticky top-0 z-50 bg-[var(--color-paper)]/90 backdrop-blur-[6px] border-b border-[var(--color-grid-bold)]">
  <div class="max-w-[1200px] mx-auto px-6 h-14 flex items-center justify-between gap-6">
    <!-- Brand wordmark — tight serif + monospace subtitle -->
    <a href={homeHref} class="flex items-baseline gap-3 group">
      <div class="flex items-center gap-2">
        <!-- ECG mini icon: tiny heartbeat path -->
        <svg class="w-5 h-5" viewBox="0 0 24 16" fill="none" aria-hidden="true">
          <path d="M0 8 L5 8 L7 4 L9 12 L11 2 L13 14 L15 8 L24 8" stroke="var(--color-ink)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        <span class="font-display text-[18px] font-[650] tracking-tight text-[var(--color-ink)]">Bandwidth ECG</span>
      </div>
      <span class="hidden md:inline mono-label text-[10px] text-[var(--color-ink-3)]">{t('header.subtitle')}</span>
    </a>

    <nav class="hidden lg:flex items-center gap-7">
      <a href="#features" class="mono-label text-[11px] text-[var(--color-ink-2)] hover:text-[var(--color-signal)] transition-colors">{t('header.features')}</a>
      <a href="#how" class="mono-label text-[11px] text-[var(--color-ink-2)] hover:text-[var(--color-signal)] transition-colors">{t('header.howItWorks')}</a>
      <a href="#faq" class="mono-label text-[11px] text-[var(--color-ink-2)] hover:text-[var(--color-signal)] transition-colors">{t('header.faq')}</a>
      <span class="w-px h-4 bg-[var(--color-grid-bold)]"></span>
      <LanguageSwitcher />
      <a href="#download" class="mono-label text-[11px] flex items-center gap-2 px-3.5 py-2 border border-[var(--color-ink)] rounded-[3px] text-[var(--color-ink)] hover:bg-[var(--color-ink)] hover:text-[var(--color-paper)] transition-all">
        <span class="w-1.5 h-1.5 rounded-full bg-[var(--color-signal)] live-dot"></span>
        {t('header.download')}
      </a>
    </nav>

    <button class="lg:hidden p-2 text-[var(--color-ink)]" aria-label={t('header.openMenu')}>
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </button>
  </div>
</header>
