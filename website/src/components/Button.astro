---
// V1 Clinical ECG — instrument-style buttons
interface Props {
  variant?: 'signal' | 'ghost'
  href?: string
  class?: string
}

const {
  variant = 'signal',
  href,
  class: className = ''
} = Astro.props

const variantClass = variant === 'signal' ? 'btn-signal' : 'btn-ghost'
const classes = `${variantClass} ${className}`
---

{href ? (
  <a href={href} class={classes}>
    <slot />
  </a>
) : (
  <button class={classes}>
    <slot />
  </button>
)}
