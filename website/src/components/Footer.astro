---
// V1 Clinical ECG — Footer with rubber-stamp DIAGNOSTIC READY badge
import { type Lang, defaultLang, useTranslations, getLocalizedPath } from '../i18n'

interface Props {
  lang?: Lang
}

const { lang = defaultLang } = Astro.props
const t = useTranslations(lang)
const homeHref = getLocalizedPath(lang, '/')

const currentYear = new Date().getFullYear()
---

<footer class="bg-[#FBFAF5] border-t border-[#0D0D0D] pt-16 pb-10">
  <div class="clinic-container">

    <!-- Top: wordmark + legend + stamp -->
    <div class="grid grid-cols-1 md:grid-cols-[1.3fr_1fr_auto] gap-10 pb-10 border-b border-dashed border-[#8C8677]/40 items-start">
      <!-- Brand -->
      <div>
        <a href={homeHref} class="flex items-baseline gap-3 mb-4">
          <svg class="w-6 h-6" viewBox="0 0 24 16" fill="none" aria-hidden="true">
            <path d="M0 8 L5 8 L7 4 L9 12 L11 2 L13 14 L15 8 L24 8" stroke="#0D0D0D" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          <span class="font-display text-[22px] font-[650] tracking-tight text-[#0D0D0D]">Bandwidth ECG</span>
        </a>
        <p class="text-[14px] leading-[1.7] text-[#5A5A5A] max-w-[420px]">
          {t('meta.description')}
        </p>
        <p class="mt-4 mono-label text-[10px] text-[#8C8677]">
          {t('footer.disclaimer')}
        </p>
      </div>

      <!-- Chart links -->
      <div class="grid grid-cols-2 gap-8">
        <div>
          <h4 class="mono-label text-[#0D0D0D] mb-3">INDEX</h4>
          <ul class="space-y-2">
            <li><a href="#features" class="text-[14px] text-[#5A5A5A] hover:text-[#0D0D0D]">{t('header.features')}</a></li>
            <li><a href="#how" class="text-[14px] text-[#5A5A5A] hover:text-[#0D0D0D]">{t('header.howItWorks')}</a></li>
            <li><a href="#chart" class="text-[14px] text-[#5A5A5A] hover:text-[#0D0D0D]">Live rhythm strip</a></li>
            <li><a href="#faq" class="text-[14px] text-[#5A5A5A] hover:text-[#0D0D0D]">{t('header.faq')}</a></li>
          </ul>
        </div>
        <div>
          <h4 class="mono-label text-[#0D0D0D] mb-3">SOURCE</h4>
          <ul class="space-y-2">
            <li><a href="https://github.com/bobo52310/bandwidth-monitor" class="text-[14px] text-[#5A5A5A] hover:text-[#0D0D0D]">GitHub</a></li>
            <li><a href="https://github.com/bobo52310/bandwidth-monitor/releases" class="text-[14px] text-[#5A5A5A] hover:text-[#0D0D0D]">Releases</a></li>
            <li><a href="https://github.com/bobo52310/bandwidth-monitor/issues" class="text-[14px] text-[#5A5A5A] hover:text-[#0D0D0D]">Report issue</a></li>
            <li><a href="#download" class="text-[14px] text-[#5A5A5A] hover:text-[#0D0D0D]">{t('header.download')}</a></li>
          </ul>
        </div>
      </div>

      <!-- Rubber-stamp badge -->
      <div class="shrink-0">
        <div class="stamp">
          <span aria-hidden="true">✓</span>
          {t('footer.stamp')}
        </div>
      </div>
    </div>

    <!-- Bottom legal strip -->
    <div class="mt-8 flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
      <p class="mono-label text-[10px] text-[#8C8677]">
        &copy; {currentYear} &middot; {t('footer.copyright')} &middot; {t('footer.madeIn')}
      </p>
      <div class="flex items-center gap-5 mono-label text-[10px] text-[#8C8677]">
        <span class="flex items-center gap-2">
          <span class="w-1.5 h-1.5 rounded-full bg-[#00B86B] live-dot"></span>
          <span>SYSTEMS NOMINAL</span>
        </span>
        <span>v1.0.0</span>
      </div>
    </div>
  </div>
</footer>
