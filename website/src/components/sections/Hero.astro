---
// V1 Clinical ECG — Hero with continuously tracing ECG waveform
import { type Lang, defaultLang, useTranslations } from '../../i18n'

interface Props {
  lang?: Lang
}

const { lang = defaultLang } = Astro.props
const t = useTranslations(lang)

// Pre-computed ECG PQRST trace path (repeats across 1600 viewBox units)
// Flat baseline with sharp R-spikes every ~200 units
const ecgPath = [
  'M 0 60',
  // beat 1
  'L 40 60', 'L 52 58', 'L 60 60',
  'L 80 60', 'L 86 65', 'L 90 32', 'L 96 90', 'L 102 60',
  'L 130 60', 'L 140 55', 'L 160 60',
  // beat 2
  'L 200 60', 'L 212 58', 'L 220 60',
  'L 240 60', 'L 246 65', 'L 250 32', 'L 256 90', 'L 262 60',
  'L 290 60', 'L 300 55', 'L 320 60',
  // beat 3
  'L 360 60', 'L 372 58', 'L 380 60',
  'L 400 60', 'L 406 65', 'L 410 32', 'L 416 90', 'L 422 60',
  'L 450 60', 'L 460 55', 'L 480 60',
  // beat 4
  'L 520 60', 'L 532 58', 'L 540 60',
  'L 560 60', 'L 566 65', 'L 570 32', 'L 576 90', 'L 582 60',
  'L 610 60', 'L 620 55', 'L 640 60',
  // beat 5
  'L 680 60', 'L 692 58', 'L 700 60',
  'L 720 60', 'L 726 65', 'L 730 32', 'L 736 90', 'L 742 60',
  'L 770 60', 'L 780 55', 'L 800 60',
  // beat 6
  'L 840 60', 'L 852 58', 'L 860 60',
  'L 880 60', 'L 886 65', 'L 890 32', 'L 896 90', 'L 902 60',
  'L 930 60', 'L 940 55', 'L 960 60',
  // beat 7
  'L 1000 60', 'L 1012 58', 'L 1020 60',
  'L 1040 60', 'L 1046 65', 'L 1050 32', 'L 1056 90', 'L 1062 60',
  'L 1090 60', 'L 1100 55', 'L 1120 60',
  // beat 8
  'L 1160 60', 'L 1172 58', 'L 1180 60',
  'L 1200 60', 'L 1206 65', 'L 1210 32', 'L 1216 90', 'L 1222 60',
  'L 1250 60', 'L 1260 55', 'L 1280 60',
  'L 1600 60'
].join(' ')

// Upload trace — smaller spikes, slightly different phase
const uploadPath = [
  'M 0 60',
  'L 60 60', 'L 72 58', 'L 80 60',
  'L 100 60', 'L 106 63', 'L 110 45', 'L 116 75', 'L 122 60',
  'L 150 60', 'L 160 57', 'L 180 60',
  'L 260 60', 'L 272 58', 'L 280 60',
  'L 300 60', 'L 306 63', 'L 310 45', 'L 316 75', 'L 322 60',
  'L 350 60', 'L 360 57', 'L 380 60',
  'L 460 60', 'L 472 58', 'L 480 60',
  'L 500 60', 'L 506 63', 'L 510 45', 'L 516 75', 'L 522 60',
  'L 550 60', 'L 560 57', 'L 580 60',
  'L 660 60', 'L 672 58', 'L 680 60',
  'L 700 60', 'L 706 63', 'L 710 45', 'L 716 75', 'L 722 60',
  'L 750 60', 'L 760 57', 'L 780 60',
  'L 860 60', 'L 872 58', 'L 880 60',
  'L 900 60', 'L 906 63', 'L 910 45', 'L 916 75', 'L 922 60',
  'L 950 60', 'L 960 57', 'L 980 60',
  'L 1060 60', 'L 1072 58', 'L 1080 60',
  'L 1100 60', 'L 1106 63', 'L 1110 45', 'L 1116 75', 'L 1122 60',
  'L 1150 60', 'L 1160 57', 'L 1180 60',
  'L 1260 60', 'L 1272 58', 'L 1280 60',
  'L 1600 60'
].join(' ')
---

<section class="relative overflow-hidden pt-20 pb-24 md:pt-28 md:pb-32">
  <div class="clinic-container relative">

    <!-- Top strip: simplified session header, 2 columns -->
    <div class="flex items-center justify-between gap-5 mb-14 pb-3.5 border-b border-[var(--color-grid-bold)]">
      <span class="mono-label text-[11px] text-[var(--color-ink-3)]">
        BANDWIDTH ECG &middot; SESSION &middot; <span id="acq-time">14:32:07</span>
      </span>
      <span class="flex items-center gap-2">
        <span class="w-1.5 h-1.5 rounded-full bg-[var(--color-red)] live-dot"></span>
        <span class="mono-label text-[11px] text-[var(--color-red-text)] font-semibold">{t('hero.live')}</span>
      </span>
    </div>

    <div class="grid lg:grid-cols-[1.15fr_1fr] gap-14 items-start">
      <!-- LEFT: Copy + CTAs -->
      <div>
        <p class="eyebrow mb-6 text-[var(--color-signal-dark)]">{t('hero.eyebrow')}</p>

        <h1 class="font-display text-[44px] sm:text-[56px] lg:text-[72px] leading-[0.98] font-[650] tracking-[-0.03em] text-[var(--color-ink)]">
          {t('hero.titleEn')}
        </h1>
        <h2 class="font-display text-[22px] sm:text-[26px] lg:text-[30px] leading-tight font-[600] text-[var(--color-ink-2)] mt-4 tracking-tight">
          {t('hero.titleZh')}
        </h2>

        <!-- Underscore divider — like a signature line -->
        <div class="mt-8 h-px w-24 bg-[var(--color-ink)]"></div>

        <p class="mt-8 text-[17px] lg:text-[18px] leading-[1.7] text-[var(--color-ink-2)] max-w-[560px]">
          {t('hero.subtitle')}
        </p>

        <div class="mt-10 flex flex-wrap gap-3 items-center">
          <a href="#download" class="btn-signal">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
              <path d="M12 3v12m0 0l-5-5m5 5l5-5M5 21h14" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            {t('hero.ctaDownload')}
          </a>
          <a href="#features" class="btn-ghost">
            {t('hero.ctaLearn')}
            <span aria-hidden="true">&rarr;</span>
          </a>
        </div>

        <!-- Readouts strip — like a lab panel footer -->
        <div class="mt-14 grid grid-cols-3 gap-4 max-w-[560px]">
          <div class="border-l-2 border-[var(--color-signal)] pl-4">
            <div class="mono-label text-[var(--color-ink-3)]">Sampling</div>
            <div class="readout text-[24px] num-tick">1<span class="text-[13px] text-[var(--color-ink-3)] ml-1">Hz</span></div>
          </div>
          <div class="border-l-2 border-[var(--color-signal)] pl-4">
            <div class="mono-label text-[var(--color-ink-3)]">Range</div>
            <div class="readout text-[24px] num-tick">1m–24<span class="text-[13px] text-[var(--color-ink-3)] ml-1">h</span></div>
          </div>
          <div class="border-l-2 border-[var(--color-signal)] pl-4">
            <div class="mono-label text-[var(--color-ink-3)]">macOS</div>
            <div class="readout text-[24px]">14<span class="text-[13px] text-[var(--color-ink-3)] ml-1">+</span></div>
          </div>
        </div>
      </div>

      <!-- RIGHT: Monitor mockup with two animated ECG traces -->
      <div class="relative">
        <!-- Monitor "hardware" label -->
        <div class="flex flex-wrap items-center justify-between gap-x-3 gap-y-1 mb-2 px-1">
          <span class="mono-label text-[11px] text-[var(--color-ink-3)]">MONITOR · BandwidthECG.app</span>
          <span class="flex items-center gap-3">
            <span class="mono-label text-[11px] text-[var(--color-ink-2)] border border-[var(--color-grid-bold)] rounded-[2px] px-1.5 py-0.5 whitespace-nowrap">{t('common.sampleData')}</span>
            <span class="mono-label text-[11px] text-[var(--color-signal-dark)] flex items-center gap-1.5">
              <span class="w-1.5 h-1.5 rounded-full bg-[var(--color-signal)] live-dot"></span>
              RECORDING
            </span>
          </span>
        </div>

        <div class="monitor-shell">
          <!-- Fake menu bar strip -->
          <div class="flex items-center justify-between bg-[var(--color-paper-dim)] border-b border-[var(--color-grid-bold)] px-3 py-1.5">
            <div class="flex items-center gap-1.5">
              <span class="w-2.5 h-2.5 rounded-full bg-[var(--color-grid-bold)]"></span>
              <span class="w-2.5 h-2.5 rounded-full bg-[var(--color-grid-bold)]"></span>
              <span class="w-2.5 h-2.5 rounded-full bg-[var(--color-grid-bold)]"></span>
            </div>
            <div class="flex items-center gap-3">
              <span class="mono-label text-[11px] text-[var(--color-ink-2)] flex items-center gap-1.5">
                <svg width="12" height="8" viewBox="0 0 24 16" aria-hidden="true"><path d="M0 8 L5 8 L7 4 L9 12 L11 2 L13 14 L15 8 L24 8" stroke="var(--color-signal)" stroke-width="2" fill="none"/></svg>
                <span class="readout text-[11px]">318.4</span>
                <span>&darr;</span>
                <span class="readout text-[11px]">42.1</span>
                <span>&uarr;</span>
                <span class="text-[var(--color-ink-3)]">Mbps</span>
              </span>
            </div>
          </div>

          <!-- Diagnostic panel body — THIS is where the ECG grid lives -->
          <div class="ecg-paper-monitor p-5">
            <!-- Lead I — DOWN -->
            <div class="mb-5">
              <div class="flex items-center justify-between mb-1.5">
                <span class="mono-label text-[var(--color-ink)] font-[600]">{t('hero.leadDown')}</span>
                <div class="flex items-baseline gap-1">
                  <span class="readout text-[22px] font-[600] text-[var(--color-ink)]">318.4</span>
                  <span class="mono-label text-[var(--color-ink-3)]">Mbps</span>
                </div>
              </div>
              <div class="relative h-[110px] bg-[var(--color-paper)]/60 border border-[var(--color-grid-bold)] rounded-[2px] overflow-hidden">
                <svg viewBox="0 0 1600 120" preserveAspectRatio="none" class="w-full h-full" aria-hidden="true">
                  <line x1="0" y1="60" x2="1600" y2="60" stroke="var(--color-grid-bold)" stroke-width="0.5" stroke-dasharray="4 4"/>
                  <path d={ecgPath} class="ecg-trace"/>
                </svg>
                <div class="absolute top-1/2 right-3 -translate-y-1/2">
                  <svg width="10" height="10" viewBox="0 0 10 10" aria-hidden="true"><circle cx="5" cy="5" r="3.5" class="ecg-cursor"/></svg>
                </div>
              </div>
            </div>

            <!-- Lead II — UP -->
            <div>
              <div class="flex items-center justify-between mb-1.5">
                <span class="mono-label text-[var(--color-ink)] font-[600]">{t('hero.leadUp')}</span>
                <div class="flex items-baseline gap-1">
                  <span class="readout text-[22px] font-[600] text-[var(--color-ink)]">42.1</span>
                  <span class="mono-label text-[var(--color-ink-3)]">Mbps</span>
                </div>
              </div>
              <div class="relative h-[90px] bg-[var(--color-paper)]/60 border border-[var(--color-grid-bold)] rounded-[2px] overflow-hidden">
                <svg viewBox="0 0 1600 120" preserveAspectRatio="none" class="w-full h-full" aria-hidden="true">
                  <line x1="0" y1="60" x2="1600" y2="60" stroke="var(--color-grid-bold)" stroke-width="0.5" stroke-dasharray="4 4"/>
                  <path d={uploadPath} class="ecg-trace ecg-trace--slow"/>
                </svg>
                <div class="absolute top-1/2 right-3 -translate-y-1/2">
                  <svg width="10" height="10" viewBox="0 0 10 10" aria-hidden="true"><circle cx="5" cy="5" r="3.5" class="ecg-cursor"/></svg>
                </div>
              </div>
            </div>

            <!-- Bottom readings strip — reduced to 2 most meaningful stats -->
            <div class="mt-5 pt-4 border-t border-dashed border-[var(--color-grid-bold)] grid grid-cols-2 gap-3">
              <div>
                <div class="mono-label text-[var(--color-ink-3)] text-[11px]">{t('hero.todayPeak')}</div>
                <div class="readout text-[15px] text-[var(--color-ink)]">471.8 <span class="text-[var(--color-ink-3)] text-[11px]">Mbps</span></div>
              </div>
              <div>
                <div class="mono-label text-[var(--color-ink-3)] text-[11px]">{t('hero.planUsage')}</div>
                <div class="readout text-[15px] text-[var(--color-signal-dark)]">63 <span class="text-[var(--color-ink-3)] text-[11px]">% · 500 Mbps</span></div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script is:inline>
    (() => {
      const el = document.getElementById('acq-time');
      if (!el) return;
      // A clock that keeps changing is motion too: hold it still for reduced-motion users.
      if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      const start = new Date();
      start.setHours(14, 32, 7);
      setInterval(() => {
        start.setSeconds(start.getSeconds() + 1);
        const hh = String(start.getHours()).padStart(2, '0');
        const mm = String(start.getMinutes()).padStart(2, '0');
        const ss = String(start.getSeconds()).padStart(2, '0');
        el.textContent = `${hh}:${mm}:${ss}`;
      }, 1000);
    })();
  </script>
</section>
