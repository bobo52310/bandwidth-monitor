---
// V3 專業商務風格 - Hero Section
import Button from '../Button.astro'
---

<section class="pt-28 pb-20 md:pt-36 md:pb-28 bg-gradient-to-b from-slate-50 to-white">
  <div class="max-w-7xl mx-auto px-6">
    <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">
      <!-- Text Content -->
      <div class="text-center lg:text-left">
        <!-- Trust badges -->
        <div class="flex flex-wrap items-center justify-center lg:justify-start gap-3 mb-6 animate-fade-in-up">
          <span class="badge badge-primary">macOS 專屬</span>
          <span class="badge badge-gold">企業級效能</span>
        </div>

        <!-- Title -->
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-slate-900 leading-tight mb-6 animate-fade-in-up delay-100">
          用數據決定，<br class="hidden sm:block" />
          <span class="gradient-text-pro">是否升級網路方案</span>
        </h1>

        <!-- Subtitle -->
        <p class="text-lg md:text-xl text-slate-600 leading-relaxed mb-8 max-w-xl mx-auto lg:mx-0 animate-fade-in-up delay-200">
          即時監控網速、追蹤峰值、做出明智決策。專業級 macOS 網路監控解決方案。
        </p>

        <!-- CTA Buttons -->
        <div class="flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-4 animate-fade-in-up delay-300">
          <Button href="#download" size="lg">
            <svg class="w-5 h-5 mr-2" fill="currentColor" viewBox="0 0 24 24">
              <path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.81-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11z"/>
            </svg>
            免費下載
          </Button>
          <Button href="#features" variant="ghost" size="lg">
            了解更多
            <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </Button>
        </div>

        <!-- Stats -->
        <div class="flex items-center justify-center lg:justify-start gap-8 mt-12 pt-8 border-t border-slate-200 animate-fade-in-up delay-400">
          <div>
            <div class="text-3xl font-bold text-slate-900">< 1%</div>
            <div class="text-sm text-slate-500">CPU 使用率</div>
          </div>
          <div class="w-px h-12 bg-slate-200"></div>
          <div>
            <div class="text-3xl font-bold text-slate-900">< 50MB</div>
            <div class="text-sm text-slate-500">記憶體佔用</div>
          </div>
          <div class="w-px h-12 bg-slate-200"></div>
          <div>
            <div class="text-3xl font-bold text-slate-900">24hr</div>
            <div class="text-sm text-slate-500">歷史追蹤</div>
          </div>
        </div>
      </div>

      <!-- App Preview -->
      <div class="animate-fade-in-up delay-200">
        <div class="relative">
          <!-- macOS Window Frame -->
          <div class="bg-white rounded-2xl shadow-2xl shadow-slate-200 overflow-hidden border border-slate-200">
            <!-- Window Title Bar -->
            <div class="flex items-center gap-2 px-4 py-3 bg-slate-50 border-b border-slate-100">
              <div class="w-3 h-3 rounded-full bg-red-400"></div>
              <div class="w-3 h-3 rounded-full bg-yellow-400"></div>
              <div class="w-3 h-3 rounded-full bg-green-400"></div>
              <span class="ml-4 text-sm text-slate-500 font-medium">Network Peak Monitor</span>
            </div>

            <!-- App Content -->
            <div class="p-6 bg-white">
              <!-- Header stats -->
              <div class="flex items-center justify-between mb-6">
                <div class="flex items-center gap-6">
                  <div>
                    <div class="text-xs text-slate-500 uppercase tracking-wide font-medium">下載</div>
                    <div class="text-2xl font-bold text-[#1E40AF]">125.4 MB/s</div>
                  </div>
                  <div>
                    <div class="text-xs text-slate-500 uppercase tracking-wide font-medium">上傳</div>
                    <div class="text-2xl font-bold text-slate-700">12.8 MB/s</div>
                  </div>
                </div>
                <div class="flex items-center gap-2 px-3 py-1.5 bg-green-50 rounded-full">
                  <div class="w-2 h-2 bg-green-500 rounded-full"></div>
                  <span class="text-xs font-medium text-green-700">監控中</span>
                </div>
              </div>

              <!-- Chart Preview -->
              <div class="h-40 bg-slate-50 rounded-xl p-4 mb-6">
                <svg class="w-full h-full" viewBox="0 0 400 120" preserveAspectRatio="none">
                  <defs>
                    <linearGradient id="v3ChartGradient" x1="0%" y1="0%" x2="0%" y2="100%">
                      <stop offset="0%" stop-color="#1E40AF" stop-opacity="0.2" />
                      <stop offset="100%" stop-color="#1E40AF" stop-opacity="0.02" />
                    </linearGradient>
                  </defs>
                  <path
                    d="M0,100 Q20,90 40,85 T80,70 T120,55 T160,40 T200,45 T240,35 T280,25 T320,30 T360,20 T400,15 L400,120 L0,120 Z"
                    fill="url(#v3ChartGradient)"
                  />
                  <path
                    d="M0,100 Q20,90 40,85 T80,70 T120,55 T160,40 T200,45 T240,35 T280,25 T320,30 T360,20 T400,15"
                    fill="none"
                    stroke="#1E40AF"
                    stroke-width="2"
                  />
                </svg>
              </div>

              <!-- Stats Grid -->
              <div class="grid grid-cols-3 gap-4">
                <div class="p-4 bg-slate-50 rounded-xl">
                  <div class="text-xs text-slate-500 uppercase tracking-wide font-medium mb-1">今日峰值</div>
                  <div class="text-lg font-bold text-slate-900">156.2 MB/s</div>
                </div>
                <div class="p-4 bg-slate-50 rounded-xl">
                  <div class="text-xs text-slate-500 uppercase tracking-wide font-medium mb-1">歷史最高</div>
                  <div class="text-lg font-bold text-slate-900">312.5 MB/s</div>
                </div>
                <div class="p-4 bg-[#1E40AF]/5 rounded-xl">
                  <div class="text-xs text-[#1E40AF] uppercase tracking-wide font-medium mb-1">方案使用率</div>
                  <div class="text-lg font-bold text-[#1E40AF]">78%</div>
                </div>
              </div>
            </div>
          </div>

          <!-- Decorative badge -->
          <div class="absolute -top-3 -right-3 px-3 py-1.5 bg-[#D97706] text-white text-xs font-semibold rounded-full shadow-lg">
            免費使用
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
