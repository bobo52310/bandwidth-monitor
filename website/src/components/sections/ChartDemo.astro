---
// V3 專業商務風格 - Chart Demo Section
---

<section class="bg-white">
  <div class="max-w-7xl mx-auto px-6">
    <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">
      <!-- Text Content -->
      <div>
        <span class="badge badge-primary mb-4">數據視覺化</span>
        <h2 class="text-3xl md:text-4xl font-bold text-slate-900 mb-6">
          專業級數據分析
        </h2>
        <p class="text-lg text-slate-600 leading-relaxed mb-8">
          從 1 分鐘到 24 小時的多時間區間數據視覺化，協助您深入了解網路使用模式與趨勢變化。
        </p>

        <!-- Feature list -->
        <div class="space-y-4">
          <div class="flex items-start gap-4">
            <div class="w-10 h-10 flex items-center justify-center bg-[#1E40AF]/5 text-[#1E40AF] rounded-lg flex-shrink-0">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            </div>
            <div>
              <h4 class="font-semibold text-slate-900 mb-1">多時間區間</h4>
              <p class="text-slate-600 text-sm">支援 1分鐘、5分鐘、1小時、24小時四種時間尺度</p>
            </div>
          </div>

          <div class="flex items-start gap-4">
            <div class="w-10 h-10 flex items-center justify-center bg-[#1E40AF]/5 text-[#1E40AF] rounded-lg flex-shrink-0">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16V4m0 0L3 8m4-4l4 4m6 0v12m0 0l4-4m-4 4l-4-4" />
              </svg>
            </div>
            <div>
              <h4 class="font-semibold text-slate-900 mb-1">上下行分離顯示</h4>
              <p class="text-slate-600 text-sm">上傳與下載流量分別追蹤，清晰呈現流量類型</p>
            </div>
          </div>

          <div class="flex items-start gap-4">
            <div class="w-10 h-10 flex items-center justify-center bg-[#D97706]/5 text-[#D97706] rounded-lg flex-shrink-0">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6" />
              </svg>
            </div>
            <div>
              <h4 class="font-semibold text-slate-900 mb-1">峰值智能標記</h4>
              <p class="text-slate-600 text-sm">自動識別並標記高峰使用時段，快速定位問題</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Chart Demo -->
      <div class="card-pro p-6">
        <!-- Header -->
        <div class="flex items-center justify-between mb-6">
          <div>
            <h3 class="font-semibold text-slate-900">歷史趨勢分析</h3>
            <p class="text-sm text-slate-500">即時更新中</p>
          </div>
          <div class="flex gap-1 p-1 bg-slate-100 rounded-lg">
            <button class="px-3 py-1.5 text-xs font-semibold text-white bg-[#1E40AF] rounded-md">1m</button>
            <button class="px-3 py-1.5 text-xs font-medium text-slate-600 hover:bg-white rounded-md transition-colors">5m</button>
            <button class="px-3 py-1.5 text-xs font-medium text-slate-600 hover:bg-white rounded-md transition-colors">1h</button>
            <button class="px-3 py-1.5 text-xs font-medium text-slate-600 hover:bg-white rounded-md transition-colors">24h</button>
          </div>
        </div>

        <!-- Chart Area -->
        <div class="relative h-64 bg-slate-50 rounded-xl p-4">
          <!-- Y-axis labels -->
          <div class="absolute left-2 top-2 bottom-2 flex flex-col justify-between text-[10px] text-slate-400 font-medium">
            <span>200</span>
            <span>150</span>
            <span>100</span>
            <span>50</span>
            <span>0</span>
          </div>

          <!-- Chart visualization -->
          <svg class="absolute inset-0 ml-8 mt-2 mb-2 mr-2" viewBox="0 0 400 200" preserveAspectRatio="none">
            <!-- Grid lines -->
            <g stroke="#E2E8F0" stroke-width="0.5">
              <line x1="0" y1="50" x2="400" y2="50" />
              <line x1="0" y1="100" x2="400" y2="100" />
              <line x1="0" y1="150" x2="400" y2="150" />
            </g>

            <!-- Download area -->
            <defs>
              <linearGradient id="v3ProGradient" x1="0%" y1="0%" x2="0%" y2="100%">
                <stop offset="0%" stop-color="#1E40AF" stop-opacity="0.15" />
                <stop offset="100%" stop-color="#1E40AF" stop-opacity="0.02" />
              </linearGradient>
            </defs>

            <path
              d="M0,180 Q20,170 40,160 T80,140 T120,120 T160,90 T200,100 T240,80 T280,60 T320,70 T360,50 T400,40 L400,200 L0,200 Z"
              fill="url(#v3ProGradient)"
            />
            <path
              d="M0,180 Q20,170 40,160 T80,140 T120,120 T160,90 T200,100 T240,80 T280,60 T320,70 T360,50 T400,40"
              fill="none"
              stroke="#1E40AF"
              stroke-width="2"
            />

            <!-- Upload line -->
            <path
              d="M0,190 Q20,188 40,185 T80,180 T120,175 T160,170 T200,172 T240,165 T280,160 T320,165 T360,155 T400,150"
              fill="none"
              stroke="#1E40AF"
              stroke-width="1.5"
              stroke-opacity="0.4"
            />

            <!-- Peak marker -->
            <circle cx="280" cy="60" r="5" fill="#D97706" />
            <line x1="280" y1="60" x2="280" y2="200" stroke="#D97706" stroke-width="1" stroke-dasharray="4,4" opacity="0.4" />
          </svg>

          <!-- Peak Tooltip -->
          <div class="absolute top-2 right-4 bg-white border border-slate-200 rounded-lg px-3 py-2 shadow-sm">
            <div class="flex items-center gap-1.5 mb-1">
              <span class="badge badge-gold text-[9px] py-0">峰值</span>
            </div>
            <div class="text-lg font-bold text-slate-900">156.2 MB/s</div>
          </div>
        </div>

        <!-- Legend & Stats -->
        <div class="flex items-center justify-between mt-4 pt-4 border-t border-slate-100">
          <div class="flex items-center gap-6">
            <div class="flex items-center gap-2">
              <div class="w-3 h-3 bg-[#1E40AF] rounded-full"></div>
              <span class="text-sm text-slate-600">下載速度</span>
            </div>
            <div class="flex items-center gap-2">
              <div class="w-3 h-3 bg-[#1E40AF]/40 rounded-full"></div>
              <span class="text-sm text-slate-600">上傳速度</span>
            </div>
          </div>
          <div class="text-sm text-slate-500">
            單位：MB/s
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
