---
// V1 Clinical ECG — Download / Discharge prescription
import { type Lang, defaultLang, useTranslations, translations } from '../../i18n'

interface Props {
  lang?: Lang
}

const { lang = defaultLang } = Astro.props
const t = useTranslations(lang)

const features = (translations[lang] as any)?.download?.features
  ?? (translations['zh-Hant'] as any)?.download?.features ?? []
---

<section id="download" class="clinic relative overflow-hidden">
  <div class="clinic-container">
    <!-- Prescription-sheet card -->
    <div class="relative mx-auto max-w-[980px] bg-[var(--color-paper)] border-2 border-[var(--color-ink)] rounded-[4px] p-8 md:p-14 shadow-[10px_10px_0_0_rgba(0,128,80,0.15)]">

      <!-- Header: Rx line -->
      <div class="flex items-center justify-between mb-8 pb-5 border-b border-dashed border-[var(--color-ink-3)]/50">
        <div class="flex items-center gap-3">
          <span class="font-display text-[30px] font-[700] text-[var(--color-ink)] leading-none">Rx</span>
          <div class="flex flex-col">
            <span class="mono-label text-[var(--color-ink)]">{t('download.sectionEyebrow')}</span>
            <span class="mono-label text-[10px] text-[var(--color-ink-3)] mt-0.5">PRESCRIPTION · TAKE HOME</span>
          </div>
        </div>
        <div class="hidden md:flex flex-col items-end mono-label text-[10px] text-[var(--color-ink-3)]">
          <span>DATE · 2026-04-24</span>
          <span>VALID · indefinitely</span>
        </div>
      </div>

      <!-- Title -->
      <div class="grid md:grid-cols-[1.2fr_1fr] gap-10 items-start">
        <div>
          <h2 class="font-display text-[40px] sm:text-[48px] lg:text-[60px] leading-[1.02] font-[650] tracking-[-0.02em] text-[var(--color-ink)]">
            {t('download.sectionTitleEn')}
          </h2>
          <p class="font-display text-[20px] sm:text-[24px] text-[var(--color-ink-2)] mt-3 tracking-tight">
            {t('download.sectionTitleZh')}
          </p>
          <p class="mt-6 text-[16px] leading-[1.7] text-[var(--color-ink-2)] max-w-[520px]">
            {t('download.sectionSubtitle')}
          </p>

          <div class="mt-8">
            <span class="inline-flex items-center gap-2.5 px-6 py-3.5 rounded-[3px] border-2 border-dashed border-[var(--color-ink)] text-[var(--color-ink)] font-display text-[15px] font-[600] cursor-default select-none">
              <span class="w-2 h-2 rounded-full bg-[var(--color-amber)] live-dot"></span>
              Coming soon · macOS 13+
            </span>
          </div>

          <p class="mt-5 mono-label text-[11px] text-[var(--color-ink-3)]">{t('download.requirements')}</p>
        </div>

        <!-- Prescribed checklist -->
        <div class="relative">
          <div class="bg-[var(--color-paper-dim)]/60 border border-dashed border-[var(--color-ink-3)] rounded-[3px] p-6">
            <div class="mono-label text-[var(--color-ink)] mb-4">PRESCRIBED &middot; 3 ITEMS</div>
            <ul class="space-y-3">
              {features.map((feat: string) => (
                <li class="flex items-start gap-3">
                  <svg class="w-4 h-4 mt-[3px] text-[var(--color-signal)] shrink-0" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
                    <path d="M2 8 L6 12 L14 4" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                  <span class="text-[14.5px] text-[var(--color-ink)] leading-snug">{feat}</span>
                </li>
              ))}
            </ul>
            <div class="mt-5 pt-4 border-t border-dashed border-[var(--color-grid-bold)]">
              <div class="mono-label text-[10px] text-[var(--color-ink-3)]">DOSAGE</div>
              <div class="readout text-[14px] text-[var(--color-ink)] mt-0.5">Always-on &middot; 1 click install &middot; 0 maintenance</div>
            </div>
          </div>

          <!-- The rubber stamp — sits half off the card -->
          <div class="absolute -bottom-8 -right-4 sm:-right-8 z-10 rotate-[-4deg]">
            <div class="stamp">
              <span aria-hidden="true">✓</span>
              {t('download.stamp')}
            </div>
          </div>
        </div>
      </div>

      <!-- Signature at bottom -->
      <div class="mt-16 pt-6 border-t border-dashed border-[var(--color-ink-3)]/40 flex flex-col sm:flex-row sm:items-end justify-between gap-4">
        <div>
          <div class="mono-label text-[10px] text-[var(--color-ink-3)] mb-2">SIGNED BY</div>
          <div class="flex items-end gap-3">
            <span class="font-display italic text-[22px] text-[var(--color-ink)]">Bobo Chen, Engineer</span>
            <span class="h-px w-32 bg-[var(--color-ink)] mb-2"></span>
          </div>
        </div>
        <div class="mono-label text-[10px] text-[var(--color-ink-3)]">
          Rx &middot; BWECG-2026-04-24
        </div>
      </div>
    </div>
  </div>
</section>
