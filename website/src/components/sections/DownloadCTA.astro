---
// V1 Clinical ECG — Download / Discharge prescription
import { type Lang, defaultLang, useTranslations, translations } from '../../i18n'

interface Props {
  lang?: Lang
}

const { lang = defaultLang } = Astro.props
const t = useTranslations(lang)

const features = (translations[lang] as any)?.download?.features
  ?? (translations['zh-Hant'] as any)?.download?.features ?? []
---

<section id="download" class="clinic ecg-paper relative overflow-hidden">
  <div class="clinic-container">
    <!-- Prescription-sheet card -->
    <div class="relative mx-auto max-w-[980px] bg-[#FBFAF5] border-2 border-[#0D0D0D] rounded-[4px] p-8 md:p-14 shadow-[10px_10px_0_0_rgba(0,128,80,0.15)]">

      <!-- Header: Rx line -->
      <div class="flex items-center justify-between mb-8 pb-5 border-b border-dashed border-[#8C8677]/50">
        <div class="flex items-center gap-3">
          <span class="font-display text-[30px] font-[700] text-[#0D0D0D] leading-none">Rx</span>
          <div class="flex flex-col">
            <span class="mono-label text-[#0D0D0D]">{t('download.sectionEyebrow')}</span>
            <span class="mono-label text-[10px] text-[#8C8677] mt-0.5">PRESCRIPTION · TAKE HOME</span>
          </div>
        </div>
        <div class="hidden md:flex flex-col items-end mono-label text-[10px] text-[#8C8677]">
          <span>DATE · 2026-04-24</span>
          <span>VALID · indefinitely</span>
        </div>
      </div>

      <!-- Title -->
      <div class="grid md:grid-cols-[1.2fr_1fr] gap-10 items-start">
        <div>
          <h2 class="font-display text-[40px] sm:text-[48px] lg:text-[60px] leading-[1.02] font-[650] tracking-[-0.02em] text-[#0D0D0D]">
            {t('download.sectionTitleEn')}
          </h2>
          <p class="font-display text-[20px] sm:text-[24px] text-[#5A5A5A] mt-3 tracking-tight">
            {t('download.sectionTitleZh')}
          </p>
          <p class="mt-6 text-[16px] leading-[1.7] text-[#3A3A3A] max-w-[520px]">
            {t('download.sectionSubtitle')}
          </p>

          <div class="mt-8 flex flex-wrap gap-3">
            <a href="https://github.com/bobo52310/bandwidth-monitor/releases" class="btn-signal">
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
                <path d="M12 3v12m0 0l-5-5m5 5l5-5M5 21h14" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
              {t('download.ctaDownload')}
            </a>
            <a href="https://github.com/bobo52310/bandwidth-monitor" class="btn-ghost">
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M12 0C5.37 0 0 5.37 0 12c0 5.3 3.44 9.8 8.21 11.39.6.11.82-.26.82-.58v-2c-3.34.72-4.04-1.61-4.04-1.61-.55-1.39-1.33-1.76-1.33-1.76-1.09-.74.08-.73.08-.73 1.2.09 1.84 1.24 1.84 1.24 1.07 1.83 2.8 1.3 3.49.99.11-.78.42-1.3.76-1.6-2.66-.3-5.47-1.33-5.47-5.93 0-1.31.47-2.38 1.24-3.22-.13-.3-.54-1.52.12-3.17 0 0 1.01-.32 3.3 1.23.96-.27 1.98-.4 3-.4s2.04.13 3 .4c2.29-1.55 3.3-1.23 3.3-1.23.66 1.65.25 2.87.12 3.17.77.84 1.24 1.91 1.24 3.22 0 4.61-2.81 5.63-5.48 5.92.43.37.82 1.1.82 2.22v3.29c0 .32.22.69.83.58C20.57 21.8 24 17.3 24 12c0-6.63-5.37-12-12-12Z"/>
              </svg>
              {t('download.ctaGithub')}
            </a>
          </div>

          <p class="mt-5 mono-label text-[11px] text-[#8C8677]">{t('download.requirements')}</p>
        </div>

        <!-- Prescribed checklist -->
        <div class="relative">
          <div class="bg-[#F5F1E4]/60 border border-dashed border-[#8C8677] rounded-[3px] p-6">
            <div class="mono-label text-[#0D0D0D] mb-4">PRESCRIBED &middot; 3 ITEMS</div>
            <ul class="space-y-3">
              {features.map((feat: string) => (
                <li class="flex items-start gap-3">
                  <svg class="w-4 h-4 mt-[3px] text-[#00B86B] shrink-0" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
                    <path d="M2 8 L6 12 L14 4" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                  <span class="text-[14.5px] text-[#0D0D0D] leading-snug">{feat}</span>
                </li>
              ))}
            </ul>
            <div class="mt-5 pt-4 border-t border-dashed border-[#E8DFD0]">
              <div class="mono-label text-[10px] text-[#8C8677]">DOSAGE</div>
              <div class="readout text-[14px] text-[#0D0D0D] mt-0.5">Always-on &middot; 1 click install &middot; 0 maintenance</div>
            </div>
          </div>

          <!-- The rubber stamp — sits half off the card -->
          <div class="absolute -bottom-8 -right-4 sm:-right-8 z-10 rotate-[-4deg]">
            <div class="stamp">
              <span aria-hidden="true">✓</span>
              {t('download.stamp')}
            </div>
          </div>
        </div>
      </div>

      <!-- Signature at bottom -->
      <div class="mt-16 pt-6 border-t border-dashed border-[#8C8677]/40 flex flex-col sm:flex-row sm:items-end justify-between gap-4">
        <div>
          <div class="mono-label text-[10px] text-[#8C8677] mb-2">SIGNED BY</div>
          <div class="flex items-end gap-3">
            <span class="font-display italic text-[22px] text-[#0D0D0D]">B. Chen, Engineer</span>
            <span class="h-px w-32 bg-[#0D0D0D] mb-2"></span>
          </div>
        </div>
        <div class="mono-label text-[10px] text-[#8C8677]">
          Rx &middot; BWECG-2026-04-24
        </div>
      </div>
    </div>
  </div>
</section>
