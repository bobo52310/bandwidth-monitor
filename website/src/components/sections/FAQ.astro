---
// V1 Clinical ECG — Clinical Notes (FAQ as chart entries)
import { type Lang, defaultLang, useTranslations, translations } from '../../i18n'

interface Props {
  lang?: Lang
}

const { lang = defaultLang } = Astro.props
const t = useTranslations(lang)

type Item = { question: string; answer: string }
const rawItems = (translations[lang] as any)?.faq?.items
  ?? (translations['zh-Hant'] as any)?.faq?.items ?? []
const items: Item[] = rawItems as Item[]
---

<section id="faq" class="clinic border-t border-[var(--color-grid-bold)]">
  <div class="clinic-container">
    <!-- Section header -->
    <div class="section-head">
      <p class="eyebrow text-[var(--color-signal-dark)] mb-4">{t('faq.sectionEyebrow')}</p>
      <h2>{t('faq.sectionTitleEn')}</h2>
      <p class="zh">{t('faq.sectionTitleZh')}</p>
      <p class="sub">{t('faq.sectionSubtitle')}</p>
    </div>

    <!-- Chart-style Q/A entries, numbered -->
    <div class="bg-[var(--color-paper)] border border-[var(--color-ink)] rounded-[3px] divide-y divide-[var(--color-grid-bold)]">
      {items.map((item, i) => {
        const no = String(i + 1).padStart(2, '0');
        return (
          <details class="group" open={i === 0}>
            <summary class="flex items-start gap-5 px-6 py-5 cursor-pointer select-none list-none hover:bg-[var(--color-paper-dim)]/60 transition">
              <span class="shrink-0 w-9 h-9 rounded-full border-2 border-[var(--color-ink)] flex items-center justify-center font-display text-[13px] font-[700] text-[var(--color-ink)]">{no}</span>
              <div class="flex-1 min-w-0">
                <div class="flex items-baseline gap-2 mb-1">
                  <span class="mono-label text-[10px] text-[var(--color-signal-dark)]">Q:</span>
                </div>
                <h3 class="font-display text-[18px] sm:text-[20px] font-[600] text-[var(--color-ink)] leading-snug">
                  {item.question}
                </h3>
              </div>
              <span class="shrink-0 mt-1 mono-label text-[11px] text-[var(--color-ink-3)] group-open:text-[var(--color-signal)]">
                <span class="group-open:hidden">[ + ]</span>
                <span class="hidden group-open:inline">[ &ndash; ]</span>
              </span>
            </summary>
            <div class="px-6 pb-6 pl-[80px]">
              <div class="flex items-start gap-2">
                <span class="mono-label text-[10px] text-[var(--color-signal-dark)] mt-1 shrink-0">A:</span>
                <p class="text-[15px] leading-[1.75] text-[var(--color-ink-2)]">
                  {item.answer}
                </p>
              </div>
            </div>
          </details>
        );
      })}
    </div>

    <!-- Signature line -->
    <div class="mt-8 flex flex-col sm:flex-row sm:items-end justify-between gap-4">
      <div>
        <div class="mono-label text-[10px] text-[var(--color-ink-3)] mb-2">SIGNED</div>
        <div class="flex items-end gap-3">
          <span class="font-display italic text-[26px] text-[var(--color-ink)]">Dr. Bandwidth</span>
          <span class="h-px w-40 bg-[var(--color-ink)] mb-2"></span>
        </div>
      </div>
      <div class="mono-label text-[10px] text-[var(--color-ink-3)]">
        Document ID · BWECG-FAQ-2026-04
      </div>
    </div>
  </div>
</section>
