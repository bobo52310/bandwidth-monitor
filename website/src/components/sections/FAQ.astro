---
// V3 專業商務風格 - FAQ Section
const faqs = [
  {
    question: '系統需求為何？',
    answer: 'Network Peak Monitor 需要 macOS 14.0 (Sonoma) 或更新版本。應用程式採用最新的 SwiftUI 框架開發，以提供最佳的原生體驗與效能。'
  },
  {
    question: '是否會影響系統效能？',
    answer: '不會。本應用程式經過嚴格的效能優化，CPU 使用率維持在 1% 以下，記憶體佔用低於 50MB，確保在背景持續運行時不會對系統效能造成影響。'
  },
  {
    question: '如何評估是否需要升級網路方案？',
    answer: '當您的峰值速度經常達到或超過目前網路方案上限的 80-90%，且「接近方案上限」計數器頻繁增加時，建議考慮升級至更高速度的方案。'
  },
  {
    question: '應用程式會收集哪些數據？',
    answer: '本應用程式完全在本地運行，不會收集任何個人數據或使用行為。僅在用戶主動選擇上傳速度測試結果至社群排行榜時，才會傳送經過匿名化處理的速度數據。'
  },
  {
    question: '是否可以隱藏 Dock 圖示？',
    answer: '可以。在應用程式設定中可選擇僅顯示選單列圖示，隱藏 Dock 圖示，讓桌面環境更加簡潔。'
  },
  {
    question: '支援哪些網路介面類型？',
    answer: '應用程式會自動偵測並監控所有活躍的網路介面，包括 Wi-Fi、乙太網路、USB 網路分享等，並自動彙總計算總流量數據。'
  }
]
---

<section id="faq" class="bg-white">
  <div class="max-w-4xl mx-auto px-6">
    <!-- Section Header -->
    <div class="text-center mb-16">
      <span class="badge badge-primary mb-4">常見問題</span>
      <h2 class="text-3xl md:text-4xl font-bold text-slate-900 mb-4">
        常見問題解答
      </h2>
      <p class="text-lg text-slate-600">
        關於 Network Peak Monitor 的常見疑問與解答
      </p>
    </div>

    <!-- FAQ List -->
    <div class="space-y-4">
      {faqs.map((faq, index) => (
        <details class="group card-pro overflow-hidden">
          <summary class="flex items-center justify-between p-6 cursor-pointer list-none">
            <span class="font-semibold text-slate-900 pr-4">{faq.question}</span>
            <div class="w-8 h-8 flex items-center justify-center bg-slate-100 rounded-lg group-open:bg-[#1E40AF] transition-colors flex-shrink-0">
              <svg
                class="w-4 h-4 text-slate-600 group-open:text-white transition-all duration-200 group-open:rotate-180"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </div>
          </summary>
          <div class="px-6 pb-6">
            <p class="text-slate-600 leading-relaxed">{faq.answer}</p>
          </div>
        </details>
      ))}
    </div>

    <!-- Contact CTA -->
    <div class="mt-12 text-center p-8 bg-slate-50 rounded-2xl">
      <h3 class="font-semibold text-slate-900 mb-2">還有其他問題？</h3>
      <p class="text-slate-600 mb-4">歡迎至 GitHub 提交 Issue 或查看文件</p>
      <a href="https://github.com" class="inline-flex items-center gap-2 text-[#1E40AF] font-medium hover:underline">
        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
          <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
        </svg>
        前往 GitHub
      </a>
    </div>
  </div>
</section>
