---
// V3 專業商務風格 - FAQ Section
import { type Lang, defaultLang, useTranslations, translations } from '../../i18n'

interface Props {
  lang?: Lang
}

const { lang = defaultLang } = Astro.props
const t = useTranslations(lang)

const faqItems = translations[lang].faq.items as Array<{ question: string; answer: string }>
---

<section id="faq" class="bg-white">
  <div class="max-w-4xl mx-auto px-6">
    <!-- Section Header -->
    <div class="text-center mb-16">
      <span class="badge badge-primary mb-4">{t('faq.sectionBadge')}</span>
      <h2 class="text-3xl md:text-4xl font-bold text-slate-900 mb-4">
        {t('faq.sectionTitle')}
      </h2>
      <p class="text-lg text-slate-600">
        {t('faq.sectionSubtitle')}
      </p>
    </div>

    <!-- FAQ List -->
    <div class="space-y-4">
      {faqItems.map((faq, index) => (
        <details class="group card-pro overflow-hidden">
          <summary class="flex items-center justify-between p-6 cursor-pointer list-none">
            <span class="font-semibold text-slate-900 pr-4">{faq.question}</span>
            <div class="w-8 h-8 flex items-center justify-center bg-slate-100 rounded-lg group-open:bg-[#1E40AF] transition-colors flex-shrink-0">
              <svg
                class="w-4 h-4 text-slate-600 group-open:text-white transition-all duration-200 group-open:rotate-180"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </div>
          </summary>
          <div class="px-6 pb-6">
            <p class="text-slate-600 leading-relaxed">{faq.answer}</p>
          </div>
        </details>
      ))}
    </div>
  </div>
</section>
