---
// V1 Clinical ECG — Diagnostic Capabilities
import { type Lang, defaultLang, useTranslations, translations } from '../../i18n'

interface Props {
  lang?: Lang
}

const { lang = defaultLang } = Astro.props
const t = useTranslations(lang)

// Items come straight from the locale file; the Messages type guarantees the shape.
const items = translations[lang].features.items

// Icon mapping per feature (minimal line SVGs — no emojis)
const icons = [
  // 01 pulse
  `<path d="M3 12 L6 12 L8 9 L10 15 L12 6 L14 18 L16 12 L21 12" stroke-linecap="round" stroke-linejoin="round"/>`,
  // 02 peak
  `<path d="M4 16 L8 16 L12 4 L16 16 L20 16" stroke-linecap="round" stroke-linejoin="round"/><line x1="4" y1="20" x2="20" y2="20" stroke-dasharray="2 2"/>`,
  // 03 rhythm strips / multiple windows
  `<line x1="3" y1="7" x2="21" y2="7"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="17" x2="21" y2="17"/><line x1="7" y1="4" x2="7" y2="20" stroke-dasharray="2 2"/><line x1="17" y1="4" x2="17" y2="20" stroke-dasharray="2 2"/>`,
  // 04 alert triangle
  `<path d="M12 3 L22 20 L2 20 Z" stroke-linejoin="round"/><line x1="12" y1="10" x2="12" y2="14"/><circle cx="12" cy="17" r="0.8" fill="currentColor"/>`,
  // 05 local chart / disk
  `<rect x="4" y="4" width="16" height="16" rx="1" stroke-linejoin="round"/><line x1="4" y1="9" x2="20" y2="9"/><circle cx="8" cy="14" r="1.5"/>`,
  // 06 low-draw battery-like vitals
  `<rect x="3" y="8" width="16" height="8" rx="1"/><line x1="20" y1="10" x2="20" y2="14"/><line x1="6" y1="11" x2="6" y2="13"/><line x1="9" y1="11" x2="9" y2="13"/><line x1="12" y1="11" x2="12" y2="13"/>`,
]
---

<section id="features" class="clinic border-t border-b border-[var(--color-grid-bold)]">
  <div class="clinic-container">
    <!-- Section header -->
    <div class="section-head">
      <p class="eyebrow text-[var(--color-signal-dark)] mb-4">{t('features.sectionEyebrow')}</p>
      <h2>{t('features.sectionTitleEn')}</h2>
      <p class="zh">{t('features.sectionTitleZh')}</p>
      <p class="sub">{t('features.sectionSubtitle')}</p>
    </div>

    <!-- Seamless diagnostic grid — single bordered container with cells separated by thin lines -->
    <div class="feature-grid border border-[var(--color-grid-bold)] rounded-[3px] bg-[var(--color-paper)] overflow-hidden">
      {items.map((item, i) => (
        <article class="feature-cell flex flex-col p-8 min-h-[220px]">
          <div class="flex items-center justify-between mb-6">
            <span class="mono-label text-[var(--color-ink-3)]">{item.no}</span>
            <div class="text-[var(--color-signal-dark)]">
              <svg class="w-[22px] h-[22px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true" set:html={icons[i % icons.length]} />
            </div>
          </div>

          <h3 class="font-display text-[22px] font-[600] leading-tight text-[var(--color-ink)]">
            {item.title}
          </h3>
          <p class="mono-label text-[var(--color-ink-3)] mt-1.5">{item.subtitle}</p>

          <p class="mt-4 text-[14.5px] leading-[1.7] text-[var(--color-ink-2)] flex-1">
            {item.description}
          </p>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .feature-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 0;
  }
  .feature-cell {
    border-right: 1px solid var(--color-grid-bold);
    border-bottom: 1px solid var(--color-grid-bold);
    background: var(--color-paper);
    transition: background 0.2s;
  }
  .feature-cell:hover {
    background: rgba(245, 241, 228, 0.4);
  }
</style>
