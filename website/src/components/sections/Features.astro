---
// V1 Clinical ECG — Diagnostic Capabilities
import { type Lang, defaultLang, useTranslations, translations } from '../../i18n'

interface Props {
  lang?: Lang
}

const { lang = defaultLang } = Astro.props
const t = useTranslations(lang)

type Item = {
  no: string
  title: string
  subtitle: string
  description: string
  range: string
  tag: string
}

// Pull items from translations — fall back to zh-Hant
const rawItems = (translations[lang] as any)?.features?.items
  ?? (translations['zh-Hant'] as any)?.features?.items ?? []
const items: Item[] = rawItems as Item[]

// Icon mapping per feature (minimal line SVGs — no emojis)
const icons = [
  // 01 pulse
  `<path d="M3 12 L6 12 L8 9 L10 15 L12 6 L14 18 L16 12 L21 12" stroke-linecap="round" stroke-linejoin="round"/>`,
  // 02 peak
  `<path d="M4 16 L8 16 L12 4 L16 16 L20 16" stroke-linecap="round" stroke-linejoin="round"/><line x1="4" y1="20" x2="20" y2="20" stroke-dasharray="2 2"/>`,
  // 03 rhythm strips / multiple windows
  `<line x1="3" y1="7" x2="21" y2="7"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="17" x2="21" y2="17"/><line x1="7" y1="4" x2="7" y2="20" stroke-dasharray="2 2"/><line x1="17" y1="4" x2="17" y2="20" stroke-dasharray="2 2"/>`,
  // 04 alert triangle
  `<path d="M12 3 L22 20 L2 20 Z" stroke-linejoin="round"/><line x1="12" y1="10" x2="12" y2="14"/><circle cx="12" cy="17" r="0.8" fill="currentColor"/>`,
  // 05 local chart / disk
  `<rect x="4" y="4" width="16" height="16" rx="1" stroke-linejoin="round"/><line x1="4" y1="9" x2="20" y2="9"/><circle cx="8" cy="14" r="1.5"/>`,
  // 06 low-draw battery-like vitals
  `<rect x="3" y="8" width="16" height="8" rx="1"/><line x1="20" y1="10" x2="20" y2="14"/><line x1="6" y1="11" x2="6" y2="13"/><line x1="9" y1="11" x2="9" y2="13"/><line x1="12" y1="11" x2="12" y2="13"/>`,
]
---

<section id="features" class="clinic ecg-paper-soft border-t border-b border-[#E8DFD0]">
  <div class="clinic-container">
    <!-- Section header -->
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-16">
      <div class="max-w-[720px]">
        <p class="eyebrow text-[#008050] mb-4">{t('features.sectionEyebrow')}</p>
        <h2 class="font-display text-[36px] sm:text-[44px] lg:text-[54px] leading-[1.02] font-[650] tracking-[-0.02em]">
          {t('features.sectionTitleEn')}
        </h2>
        <p class="font-display text-[20px] sm:text-[22px] text-[#5A5A5A] mt-2">{t('features.sectionTitleZh')}</p>
        <p class="mt-6 text-[16px] leading-[1.7] text-[#3A3A3A] max-w-[620px]">
          {t('features.sectionSubtitle')}
        </p>
      </div>
      <div class="shrink-0 flex items-center gap-3 mono-label text-[#8C8677]">
        <span class="w-8 h-px bg-[#8C8677]"></span>
        <span>06 readings</span>
      </div>
    </div>

    <!-- Chart-style card grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
      {items.map((item, i) => (
        <article class="chart-card flex flex-col min-h-[280px]">
          <div class="chart-card__header">
            <span class="chart-no"># {item.no}</span>
            <span class="mono-label text-[#008050]">{item.tag}</span>
          </div>

          <!-- Tiny signal icon drawn in the signal green -->
          <div class="text-[#008050] mb-5">
            <svg class="w-7 h-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true" set:html={icons[i % icons.length]} />
          </div>

          <h3 class="font-display text-[22px] font-[600] leading-tight text-[#0D0D0D]">
            {item.title}
          </h3>
          <p class="mono-label text-[#8C8677] mt-1.5">{item.subtitle}</p>

          <p class="mt-4 text-[14.5px] leading-[1.7] text-[#3A3A3A] flex-1">
            {item.description}
          </p>

          <div class="mt-5 pt-4 border-t border-dashed border-[#E8DFD0] flex items-center justify-between gap-2">
            <span class="mono-label text-[10px] text-[#5A5A5A]">{item.range}</span>
            <span class="tag-normal text-[9px] py-0.5 px-1.5">
              <span class="tag-dot"></span>
              LIVE
            </span>
          </div>
        </article>
      ))}
    </div>

    <!-- Legend strip -->
    <div class="mt-10 pt-6 border-t border-dashed border-[#8C8677]/40 flex flex-wrap gap-x-8 gap-y-2 mono-label text-[11px] text-[#5A5A5A]">
      <span class="flex items-center gap-2"><span class="tag-dot text-[#008050] w-1.5 h-1.5"></span>NORMAL · within limits</span>
      <span class="flex items-center gap-2"><span class="tag-dot text-[#E8A23B] w-1.5 h-1.5"></span>ALERT · approaching ceiling</span>
      <span class="flex items-center gap-2"><span class="tag-dot text-[#D1342C] w-1.5 h-1.5"></span>CRITICAL · action required</span>
    </div>
  </div>
</section>
