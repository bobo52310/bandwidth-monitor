    "settings.latency.help" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sends one HEAD request to apple.com every 30 seconds to measure latency. It contains none of your monitoring data. Nothing is sent when this is turned off."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "遅延を測定するため、30 秒ごとに apple.com へ HEAD リクエストを 1 回送信します。監視データは含まれません。オフにすると送信されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "지연 시간을 측정하기 위해 30초마다 apple.com으로 HEAD 요청을 한 번 보냅니다. 모니터링 데이터는 포함되지 않습니다. 끄면 더 이상 보내지 않습니다."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
