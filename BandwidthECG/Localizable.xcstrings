    "reset.confirm.message" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This clears all peaks and the chart history. Monthly reports are not affected. This can't be undone; you can back up first with Export Data."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すべてのピークとグラフ履歴をクリアします。月次レポートには影響しません。この操作は取り消せません。先に「データをエクスポート」でバックアップできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모든 피크와 차트 기록이 삭제됩니다. 월간 리포트에는 영향이 없습니다. 이 작업은 되돌릴 수 없으며, 먼저 ‘데이터 내보내기’로 백업할 수 있습니다."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將清除所有峰值與圖表歷史，月度報告不受影響。此動作無法復原，可先用「導出數據」備份。"
          }
        }
      }
    },
