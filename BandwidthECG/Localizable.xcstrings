    "chart.yaxis.tooltip.auto" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auto-scale mode: Y-axis adjusts based on actual usage. Click to switch to fixed mode."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自動スケールモード：使用状況に応じてY軸を調整します。クリックで固定モードに切替。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "자동 조절 모드: 실제 사용량에 따라 Y축이 조정됩니다. 클릭하여 고정 모드로 전환."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "當前為自動縮放模式，根據實際使用範圍智能調整 Y 軸。點擊切換為固定上限模式。"
          }
        }
      }
    },
    "chart.yaxis.tooltip.fixed" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fixed mode: Y-axis shows plan speed limit. Click to switch to auto-scale mode."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "固定モード：Y軸がプラン速度上限を表示します。クリックで自動スケールモードに切替。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "고정 모드: Y축이 플랜 속도 상한을 표시합니다. 클릭하여 자동 조절 모드로 전환."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
