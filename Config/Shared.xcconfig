// Shared.xcconfig
// Minimal shared configuration for scaffold tool customization
// All other settings use Xcode project defaults
// Generated by XcodeBuildMCP

// ==========================================
// Project Identity
// ==========================================
PRODUCT_NAME = BandwidthECG
PRODUCT_DISPLAY_NAME = Bandwidth ECG
PRODUCT_BUNDLE_IDENTIFIER = com.bobo52310.BandwidthECG
MARKETING_VERSION = 1.0
CURRENT_PROJECT_VERSION = 1

// ==========================================
// Platform Configuration
// ==========================================
MACOSX_DEPLOYMENT_TARGET = 14.0

// ==========================================
// Info PLIST
// ==========================================
GENERATE_INFOPLIST_FILE = YES
// Menu bar app: start without a Dock icon. "Show in Dock" turns it on at runtime, so the
// icon never flashes at launch for a user who left it off.
INFOPLIST_KEY_LSUIElement = YES
INFOPLIST_KEY_LSApplicationCategoryType = public.app-category.utilities
INFOPLIST_KEY_NSHumanReadableCopyright = © 2026 Bobo Chen

// ==========================================
// App Icon
// ==========================================
// Without this the asset catalog is not asked to build the icon, so the app ships with none.
ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon

// ==========================================
// Entitlements
// ==========================================
// AI agents can modify Config/BandwidthECG.entitlements to add capabilities
CODE_SIGN_ENTITLEMENTS = Config/BandwidthECG.entitlements